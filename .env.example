# Frontend (React) — set in a .env file at the repo root
# Base URL of the Flask API. Omit in local dev to default to http://localhost:5555.
REACT_APP_API_URL=http://localhost:5555

# Backend (Flask) — set in a .env file inside server/
# Signing key for JWTs and Flask's session machinery. Use a long random value in production.
SECRET_KEY=your-production-secret-key-here

# SQLAlchemy connection string. Omit in local dev to default to a local SQLite file.
# In production, use a Postgres URL, e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=your-database-url-here

# Comma-separated list of origins allowed to make credentialed requests to the API.
CORS_ORIGINS=http://localhost:3000
